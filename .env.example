APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/dev.db
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
LOG_LEVEL=INFO
LOG_JSON=false
REQUIRE_EXPLICIT_APPROVAL=false
# Omit APPROVAL_REQUIRED_TOOLS to use the complete write policy.
MCP_SERVER_NAME=google-mcp-server
MCP_SERVER_VERSION=0.1.0
MCP_PATH=/mcp
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/google/callback
GOOGLE_ID_TOKEN_CLOCK_SKEW_SECONDS=10
# Omit GOOGLE_OAUTH_SCOPES to use the supported Google scopes.
JWT_ISSUER=http://localhost:8000/auth/dev
JWT_AUDIENCE=google-mcp-server
JWT_ALGORITHMS=HS256
JWT_JWKS_URL=
JWT_PUBLIC_KEY=
JWT_SHARED_SECRET=
JWT_ALLOW_NON_EXPIRING_TOKENS=false
JWT_TEST_MODE=true
JWT_TEST_TOKEN=local-dev-token
JWT_TEST_SUBJECT=local-dev-user

MCP_BODY_LIMIT_BYTES=2097152
GOOGLE_API_TIMEOUT_SECONDS=30
DRIVE_INLINE_CONTENT_LIMIT_BYTES=262144
