# Set to juliov93/mcp-google@sha256:<published-digest>. Never use latest here.
MCP_GOOGLE_IMAGE=
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://google-mcp.vmmakeup.cl
DATABASE_URL=sqlite:////app/data/mcp-google.db
ALLOWED_ORIGINS=https://google-mcp.vmmakeup.cl
ALLOWED_HOSTS=google-mcp.vmmakeup.cl,localhost,127.0.0.1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120
LOG_LEVEL=INFO
LOG_JSON=true
REQUIRE_EXPLICIT_APPROVAL=true
# Omit APPROVAL_REQUIRED_TOOLS to use the complete mutation list from app/config.py.
MCP_SERVER_NAME=google-mcp-server
MCP_SERVER_VERSION=0.1.0
MCP_PATH=/mcp
# Generate locally. Keep this encryption key when updating or restoring the database.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://google-mcp.vmmakeup.cl/oauth/google/callback
GOOGLE_ID_TOKEN_CLOCK_SKEW_SECONDS=10
# Omit GOOGLE_OAUTH_SCOPES to keep the existing scopes. An empty value disables them.
JWT_ISSUER=urn:jm-homelab:google-mcp
JWT_AUDIENCE=google-mcp-server
JWT_ALGORITHMS=HS256
JWT_SHARED_SECRET=
JWT_TEST_MODE=false

MCP_BODY_LIMIT_BYTES=2097152
GOOGLE_API_TIMEOUT_SECONDS=30
DRIVE_INLINE_CONTENT_LIMIT_BYTES=262144
