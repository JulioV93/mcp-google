{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "google-mcp": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer local-dev-token"
      }
    }
  },

  "instructions": [
    ".opencode/instructions/google-calendar-rules.md",
    "AGENTS.md"
  ]
}
